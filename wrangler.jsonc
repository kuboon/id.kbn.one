{
  "name": "id-kbn-one",
  "compatibility_date": "2026-10-19",

  // Written by `scripts/cf-build.sh`, which Workers Builds runs: Deno bundles
  // the app, because the source resolves JSR specifiers and workspace import
  // maps that esbuild knows nothing about. That bundle leaves `#env`
  // unresolved on purpose, for the alias below to supply.
  "main": "main/worker/worker.js",
  "alias": {
    "#env": "./main/server/env.workers.ts"
  },

  // Served straight from the edge, before the Worker is invoked, which is why
  // the router has no static-file middleware on this runtime. `main/bundled`
  // is a build artifact (git-ignored), written by the same build command.
  "assets": {
    "directory": "./main/bundled"
  },

  // Deno KV's replacement. D1 rather than Workers KV because the app needs
  // compare-and-set: single-use OAuth codes, refresh-token reuse detection,
  // DPoP replay rejection and push rate limiting all rest on it, and Workers
  // KV would keep returning success while those guarantees quietly vanished.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "id-kbn-one",
      "database_id": "1ad1c197-5119-4392-bf55-e863fe70334e"
    }
  ],

  // D1 has no TTL of its own. Reads already treat an expired row as absent, so
  // this only reclaims storage and a missed run costs nothing but space.
  "triggers": {
    "crons": ["23 4 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Public configuration, not secrets: the signing key lives in D1. A deploy
  // replaces these, so they belong here rather than in the dashboard.
  //
  // These did not come across from Deno Deploy, where they were only ever set
  // in the dashboard. CONFIRM `RP_ID` BEFORE THE FIRST DEPLOY: a WebAuthn
  // credential is bound to the RP ID it was created under, so if production
  // used `kbn.one` rather than `id.kbn.one`, deploying this value would make
  // all 11 migrated passkeys unusable — and no amount of fixing it afterwards
  // brings them back, because the authenticator keeps the original binding.
  "vars": {
    "RP_ID": "id.kbn.one",
    "RP_NAME": "kbn.one ID",
    "IDP_ORIGIN": "https://id.kbn.one",
    // Hostnames, subdomains included. `kbn.one` is what production must have
    // allowed: a live /authorize carried redirect_uri=https://ga-cen.kbn.one/…
    // The old Deno Deploy host is deliberately not carried over.
    "AUTHORIZE_WHITELIST": "kbn.one",
    "PUSH_CONTACT": "mailto:o@kbn.one"
  }
}
